# Canton Quests — Environment Variables Template

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CITY_ID="canton-oh"

# Supabase Configuration (Required in Phase 1+)
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Mapbox / Map Services (Optional candidate in Phase 1+)
# NEXT_PUBLIC_MAPBOX_TOKEN="your-mapbox-token-here"

# Admin Authorization & Security (Required in Phase 5+)
# ADMIN_SECRET_KEY="your-admin-secret-key-here"

# Spectator Session Security (Required in Phase 5+)
# SPECTATOR_SESSION_SECRET="your-spectator-session-secret-here"

# Founder's Cipher Prelaunch Player Access (temporary, remove after launch)
# Server-only — never expose as NEXT_PUBLIC. Lets a tester enter the real,
# unmodified Founder's Cipher gameplay before the event's official
# startTime by submitting this password on the Mission hub's prelaunch
# screen. Grants no admin privileges and no gameplay bypass of any kind —
# once entered, the tester is treated exactly like a normal post-launch
# player. Forgetting to unset this after launch is harmless: the gate is a
# no-op once the event's real startTime has passed.
# FOUNDER_CIPHER_PRELAUNCH_PASSWORD="your-temporary-prelaunch-password-here"
