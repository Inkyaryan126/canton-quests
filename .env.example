# Canton Quests — Environment Variables Template

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CITY_ID="canton-oh"

# Supabase Configuration (Required in Phase 1+)
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Mapbox / Map Services (Optional candidate in Phase 1+)
# NEXT_PUBLIC_MAPBOX_TOKEN="your-mapbox-token-here"

# Admin Authorization & Security (Required in Phase 5+)
# ADMIN_SECRET_KEY="your-admin-secret-key-here"

# Spectator Session Security (Required in Phase 5+)
# SPECTATOR_SESSION_SECRET="your-spectator-session-secret-here"
