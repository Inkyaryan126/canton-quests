#!/bin/sh
# Canton Quests Boardroom V2 — local push protection.
#
# Blocks `git push origin main` (or master) while an autonomous Boardroom
# run is active (.boardroom/runtime/AUTONOMOUS_RUN_ACTIVE exists). This
# defends against an AGENT deciding to push on its own initiative via its
# own shell access, not just the supervisor's own code path (which simply
# never calls push at all). Real local git enforcement, not a policy
# statement — see boardroom/BOARDROOM.md Section 13.
#
# Activated via: git config core.hooksPath .githooks
# (self-installed by `npm run boardroom:start` on every run).

remote="$1"
marker=".boardroom/runtime/AUTONOMOUS_RUN_ACTIVE"

if [ ! -f "$marker" ]; then
  exit 0
fi

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      if [ "$remote" = "origin" ]; then
        blocked=1
      fi
      ;;
  esac
done

if [ "$blocked" -eq 1 ]; then
  echo ""
  echo "BOARDROOM SAFETY: push to origin/main blocked."
  echo "An autonomous Boardroom run is currently active ($marker exists)."
  echo "Overnight work stays on its own boardroom/astra-overnight-<runId> branch."
  echo "Pushing to main is Dustin's morning decision — see boardroom/BOARDROOM.md."
  echo ""
  exit 1
fi

exit 0
